# Save as /etc/feishu-publisher.env and restrict permissions to root (0600).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
PUBLISH_SCOPE=subtree
ROOT_NODE_TOKEN=
# For an entire space, use PUBLISH_SCOPE=space. An independent homepage is optional.
SPACE_HOME_NODE_TOKEN=
SITE_URL=https://docs.example.com
SITE_NAME=飞书文档中心
